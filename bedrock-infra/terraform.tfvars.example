# Copy to poc.tfvars (or fisma.tfvars) and fill in. Never commit real account details if your repo is public.
# "poc" here = the existing NHANES dev AWS account, not a newly created account.

region      = "<nhanes-dev-region>"
environment = "poc"

# Exact IDs from: aws bedrock list-foundation-models --region <your-region>
# Use the two models for the bake-off (lower tier and middle tier).
allowed_model_ids = [
  "<lower-tier-model-id>",
  "<middle-tier-model-id>",
]

# Only if a model can be called solely through an inference profile.
# allowed_inference_profile_ids = ["<profile-id>"]

# Attach the invocation policy to the role pic-sure-ai-service's EC2 hosts
# actually use. Verify this against pic-sure-ai-service's real deployment (it
# follows pic-sure-operations-service's conventions but confirm the role name 
# itself rather than assuming it's identical).
attach_invocation_policy_to_role_names = ["<pic-sure-ai-service-instance-role-name>"]

# Optional: a Bedrock admin role for humans (MFA required by default).
# admin_role_trusted_principal_arns = ["arn:aws:iam::<account-id>:role/<admin-or-sso-role>"]

# Later (Phase 5), once guardrail and logging exist:
# guardrail_arns               = ["arn:aws:bedrock:<region>:<account-id>:guardrail/<id>"]
# enforce_guardrail_identifier = "arn:aws:bedrock:<region>:<account-id>:guardrail/<id>:<version>"
# log_reader_trusted_principal_arns = ["arn:aws:iam::<account-id>:role/<security-audit-role>"]
# log_bucket_name  = "<log-bucket>"
# log_group_name   = "/aws/bedrock/model-invocations"
# logs_kms_key_arn = "arn:aws:kms:<region>:<account-id>:key/<key-id>"
