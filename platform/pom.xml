<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <!-- Standalone on purpose: this BOM must NOT inherit the root parent.
         The root parent imports this BOM; a <parent> pointing back at the root
         would create a model-resolution cycle. -->
    <groupId>edu.harvard.hms.dbmi.avillach</groupId>
    <artifactId>pic-sure-bom</artifactId>
    <version>3.0.0</version>
    <packaging>pom</packaging>
    <name>PIC-SURE BOM</name>
    <description>Bill of Materials for PIC-SURE API dependencies</description>
    <properties>
        <!-- Duplicated from the root parent by design (standalone BOM cannot inherit).
             Bump these in lockstep with the root pom. -->
        <spring-boot.version>3.5.16</spring-boot.version>
        <spring-cloud.version>2025.0.0</spring-cloud.version>
        <!-- Internal artifacts: the 3.0.0 Java 25 line published from this repo.
             Legacy stays pinned to the frozen Java 11 releases and never resolves these. -->
        <pic-sure-contracts.version>3.0.0</pic-sure-contracts.version>
        <pic-sure-hpds-model.version>3.0.0</pic-sure-hpds-model.version>
        <pic-sure-logging-client.version>3.0.0</pic-sure-logging-client.version>
        <pic-sure-spring-commons.version>3.0.0</pic-sure-spring-commons.version>
        <pic-sure-operations-service.version>3.0.0</pic-sure-operations-service.version>
        <pic-sure-hpds-query-service.version>3.0.0</pic-sure-hpds-query-service.version>
        <!-- Shared third-party pins not governed by the Spring BOMs -->
        <wiremock.version>3.10.0</wiremock.version>
        <!-- HTTP-client winner (consolidation Phase 4) — aligned with spring-boot-dependencies -->
        <httpclient5.version>5.5.2</httpclient5.version>
        <!-- Structured logging encoder (not governed by the Spring BOMs) -->
        <logstash-logback-encoder.version>8.1</logstash-logback-encoder.version>
        <!-- OpenAPI: springdoc generates the documents committed under docs/api; swagger-api is the annotation +
             model line springdoc itself resolves (springdoc-openapi 2.8.13 -> swagger-core-jakarta 2.2.36). Pinning
             both here keeps every module on ONE swagger annotations artifact and ONE version, which the reactor's
             dependencyConvergence rule requires. -->
        <springdoc.version>2.8.13</springdoc.version>
        <swagger-api.version>2.2.36</swagger-api.version>
        <!-- Swagger UI viewer assets (org.webjars:swagger-ui), consumed ONLY by the gateway's /swagger-ui docs
             console. Pinned to the exact version springdoc-openapi 2.8.13 resolves, so the viewer the gateway
             bundles is the same one the document generators are built against — even though the gateway
             deliberately does NOT depend on springdoc (no live /v3/api-docs surface anywhere). -->
        <swagger-ui.version>5.28.1</swagger-ui.version>
    </properties>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Consumable jars from libs/pic-sure-commons (the pic-sure-common
                 aggregator pom itself is not a dependency target). Note the
                 distinct groupId on pic-sure-hpds-model. -->
            <dependency>
                <groupId>edu.harvard.hms.dbmi.avillach</groupId>
                <artifactId>pic-sure-contracts</artifactId>
                <version>${pic-sure-contracts.version}</version>
            </dependency>
            <dependency>
                <groupId>edu.harvard.hms.dbmi.avillach.hpds</groupId>
                <artifactId>pic-sure-hpds-model</artifactId>
                <version>${pic-sure-hpds-model.version}</version>
            </dependency>
            <!-- Historic groupId (no "hms") is frozen for compatibility. -->
            <dependency>
                <groupId>edu.harvard.dbmi.avillach</groupId>
                <artifactId>pic-sure-logging-client</artifactId>
                <version>${pic-sure-logging-client.version}</version>
            </dependency>
            <dependency>
                <groupId>edu.harvard.hms.dbmi.avillach</groupId>
                <artifactId>pic-sure-spring-commons</artifactId>
                <version>${pic-sure-spring-commons.version}</version>
            </dependency>
            <!-- OpenApiExport, shared by every service's OpenApiExportTest. -->
            <dependency>
                <groupId>edu.harvard.hms.dbmi.avillach</groupId>
                <artifactId>pic-sure-spring-commons</artifactId>
                <version>${pic-sure-spring-commons.version}</version>
                <type>test-jar</type>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>edu.harvard.hms.dbmi.avillach</groupId>
                <artifactId>pic-sure-operations-service</artifactId>
                <version>${pic-sure-operations-service.version}</version>
            </dependency>
            <dependency>
                <groupId>edu.harvard.hms.dbmi.avillach</groupId>
                <artifactId>pic-sure-hpds-query-service</artifactId>
                <version>${pic-sure-hpds-query-service.version}</version>
            </dependency>
            <!-- Test tooling shared across services -->
            <dependency>
                <groupId>org.wiremock</groupId>
                <artifactId>wiremock-standalone</artifactId>
                <version>${wiremock.version}</version>
            </dependency>
            <!-- HTTP-client winner: RestClient over Apache HttpClient 5 (Phase 4 convergence).
                 Version explicit so external BOM consumers get the winner without the Spring BOM. -->
            <dependency>
                <groupId>org.apache.httpcomponents.client5</groupId>
                <artifactId>httpclient5</artifactId>
                <version>${httpclient5.version}</version>
            </dependency>
            <dependency>
                <groupId>net.logstash.logback</groupId>
                <artifactId>logstash-logback-encoder</artifactId>
                <version>${logstash-logback-encoder.version}</version>
            </dependency>
            <!-- OpenAPI document generation. Declared test-scoped by the services: the committed
                 docs/api/*.openapi.json documents are build artifacts of record, so no service gains a live
                 /v3/api-docs endpoint (and no new unauthenticated surface) from this. -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <!-- The ONE swagger annotations artifact for the platform. The jakarta classifier is the line springdoc
                 and swagger-core-jakarta use; the non-jakarta io.swagger.core.v3:swagger-annotations ships the same
                 io.swagger.v3.oas.annotations.* classes, so declaring both would put duplicate classes on every
                 service classpath. -->
            <dependency>
                <groupId>io.swagger.core.v3</groupId>
                <artifactId>swagger-annotations-jakarta</artifactId>
                <version>${swagger-api.version}</version>
            </dependency>
            <dependency>
                <groupId>io.swagger.core.v3</groupId>
                <artifactId>swagger-core-jakarta</artifactId>
                <version>${swagger-api.version}</version>
            </dependency>
            <!-- The bundled Swagger UI assets the gateway serves at /swagger-ui. A webjar: static files only,
                 no classes and no transitive dependencies, so it adds nothing to any runtime classpath but the
                 gateway's own. -->
            <dependency>
                <groupId>org.webjars</groupId>
                <artifactId>swagger-ui</artifactId>
                <version>${swagger-ui.version}</version>
            </dependency>
            <!-- Convergence pin: the auth0 SDK pulls okio 3.5.0 directly but 3.6.0 via its
                 own OkHttp transitive (dependencyConvergence enforcement, spec §17.4). -->
            <dependency>
                <groupId>com.squareup.okio</groupId>
                <artifactId>okio</artifactId>
                <version>3.6.0</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub HMS-DBMI Apache Maven Packages</name>
            <url>https://maven.pkg.github.com/hms-dbmi/pic-sure</url>
        </repository>
    </distributionManagement>
</project>
