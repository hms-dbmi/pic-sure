      "QueryStatusResponse" : {
        "description" : "Status of a single query, as reported by PIC-SURE and by the resource backing it",
        "properties" : {
          "duration" : {
            "description" : "Milliseconds elapsed between the query being queued and completing; 0 while it is still running",
            "format" : "int64",
            "type" : "integer"
          },
          "expiration" : {
            "description" : "Epoch milliseconds at which the results expire; 0 when the backing resource reports no expiration",
            "format" : "int64",
            "type" : "integer"
          },
