            "description" : "A concept path this filter must match",
            "type" : "string"
          },
          "values" : {
            "description" : "Values for this concept path. Patients returned by this query must match at least one value for this concept path",
            "items" : {
              "type" : "string"
            },
            "type" : "array",
            "uniqueItems" : true
          }
        },
        "type" : "object"
      },
      "GenomicFilter" : {
        "properties" : {
          "key" : {
            "description" : "The genomic filter to query",
            "example" : "Gene_with_variant",
            "type" : "string"
          },
          "max" : {
            "description" : "Maximum value for a given key. Cannot be combined with `values`",
            "example" : 100,
            "format" : "float",
            "type" : "number"
          },
          "min" : {
            "description" : "Minimum value for a given key. Cannot be combined with `values`",
            "example" : 0.5,
            "format" : "float",
            "type" : "number"
          },
          "values" : {
            "description" : "Values that must match for a given key. Cannot be combined with `min` or `max`",
            "example" : "APOE",
            "items" : {
              "type" : "string"
            },
            "type" : "array"
          }
        },
        "required" : [
          "key"
        ],
        "type" : "object"
      },
      "PaginatedResponseString" : {
        "description" : "A single page of results, plus the paging metadata needed to request the rest",
        "properties" : {
          "page" : {
            "description" : "Index of this page. The base is defined by the serving endpoint, not by this record: HPDS's GET /PIC-SURE/v3/search/values/ (and the query-service passthrough in front of it) is 1-based and rejects page < 1, while the dictionary's /concepts endpoints are 0-based. See the page parameter on the endpoint you are calling.",
            "format" : "int32",
            "type" : "integer"
          },
          "results" : {
            "description" : "The results on this page",
            "items" : {
              "type" : "string"
            },
            "type" : "array"
          },
          "total" : {
            "description" : "Total number of results across all pages",
            "format" : "int32",
            "type" : "integer"
          }
        },
        "type" : "object"
      },
      "PhenotypicClause" : { },
