    "/PIC-SURE/v3/search/values/" : {
      "get" : {
        "description" : "Paging is 1-based on this endpoint: page 1 is the first page and page < 1 is rejected.",
        "operationId" : "searchGenomicConceptValues",
        "parameters" : [
          {
            "in" : "query",
            "name" : "genomicConceptPath",
            "required" : true,
