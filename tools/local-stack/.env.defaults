# Defaults for the local stack. Override any of them in local.env (not committed) or on the make command line.
# This file is read by make and by docker compose (--env-file), so it only holds KEY=VALUE lines.

# Host name used in the URLs the stack prints (set it to the machine's name to reach the stack from elsewhere)
PUBLIC_HOST=localhost
# Interface the containers publish on; 0.0.0.0 makes them reachable from other machines
BIND_ADDRESS=127.0.0.1

# layer hpds: one HPDS per loader lane
HPDS_LANE1_PORT=8081
HPDS_LANE2_PORT=8082
HPDS_LANE3_PORT=8083
HPDS_IMAGE=picsure-local-hpds:local
HPDS_JAVA_OPTS=-Xmx1g
HPDS_ID_BATCH_SIZE=1000

# Loader JVMs (run on the host, not in a container)
LOADER_XMX=2g

# Splitter: commit of pic-sure-hpds-etl that provides split-allconcepts-by-consent, and the share of rows it may set aside
SPLITTER_REF=6416d91
SPLIT_MAX_REJECT=0.05

# Dataset "synth": size and seed
PATIENTS=200
CONCEPTS=12
SEED=7
