# Defaults for the local stack. Override any of them in local.env (not committed) or on the make command line.
# This file is read by make and by docker compose (--env-file), so it only holds KEY=VALUE lines.

# Host name used in the URLs the stack prints (set it to the machine's name to reach the stack from elsewhere)
PUBLIC_HOST=localhost
# Interface the containers publish on; 0.0.0.0 makes them reachable from other machines
BIND_ADDRESS=127.0.0.1

# layer hpds: one HPDS per loader lane
HPDS_LANE1_PORT=8081
HPDS_LANE2_PORT=8082
HPDS_LANE3_PORT=8083
HPDS_IMAGE=picsure-local-hpds:local
HPDS_JAVA_OPTS=-Xmx1g
HPDS_ID_BATCH_SIZE=1000
# DATASET=dir serves an existing partition set from this port; the open-mode HPDS (OPEN=1, the default) listens on the second one
HPDS_DIR_PORT=8084
HPDS_OPEN_PORT=8085

# layer api: query-service (the HPDS ingress) and operations-service in front of the HPDS of one lane (make STORE=lane1|lane2|lane3), MySQL
# (published on 127.0.0.1 only). The credentials are local-only and protect nothing.
STORE=lane3
API_QUERY_PORT=8091
API_OPERATIONS_PORT=8092
API_MYSQL_PORT=33306
API_QUERY_IMAGE=picsure-local-query-service:local
API_OPERATIONS_IMAGE=picsure-local-operations-service:local
API_MYSQL_IMAGE=mysql:8.4
API_FLYWAY_IMAGE=flyway/flyway:11.14.1
API_JAVA_OPTS=-Xmx512m
API_DB_ROOT_PASSWORD=root-local
API_DB_PASSWORD=picsure-local
API_INTERNAL_TOKEN=local-internal-token
# identity the stack's queries are sent with (X-User-Id); the query-service only checks that it is present
API_USER_ID=local-stack

# layer dict: Postgres 16 (published on 127.0.0.1 only; its major version must not be older than the Postgres that made a dump you restore)
# and the picsure-dictionary service. The credentials are local-only and protect nothing.
DICT_API_PORT=8095
DICT_DB_PORT=55433
DICT_IMAGE=picsure-local-dictionary:local
DICT_POSTGRES_IMAGE=postgres:16-alpine
DICT_DB_PASSWORD=picsure-local
DICT_JAVA_OPTS=-Xmx768m

# The service code the stack serves: one commit of this repository (a local branch, origin/<ref>, upstream/<ref> or a sha), extracted with git
# archive into work/src/services-<sha>/ and built there. The default is the ref the deployed load and dev use. HPDS_REF, QUERY_REF (query-service and
# operations-service) and DICT_REF override it per service, LOADER_REF the CSVLoader of lane 2; leave them unset to follow SERVICES_REF.
SERVICES_REF=csvloader-partition-names

# Loader JVMs (run on the host, not in a container)
LOADER_XMX=2g

# Splitter: commit of pic-sure-hpds-etl that provides split-allconcepts-by-consent, and the share of rows it may set aside
SPLITTER_REF=6416d91
SPLIT_MAX_REJECT=0.05

# Dataset "synth": size and seed
PATIENTS=200
CONCEPTS=12
SEED=7
