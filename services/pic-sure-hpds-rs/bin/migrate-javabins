#!/usr/bin/env bash
# Migrates a javabin phenotype store (columnMeta.javabin, allObservationsStore.javabin,
# encryption_key) into a Rust store, through the Java ExportForMigration loader and
# hpds-etl migrate. The javabin directory is mounted read-only and never written.
#
# A consent-partitioned javabin directory, as the harmonization CSVLoader writes it (one
# encryption_key at the root and one subdirectory per partition holding columnMeta.javabin
# and allObservationsStore.javabin), is exported partition by partition and migrated into
# one store in <out-dir>, each concept's block holding every partition's rows, as
# hpds-etl migrate writes it. ExportForMigration runs once per partition, with the
# partition's two javabin files and the root key mounted read-only as its store directory.
# Only immediate subdirectories count and hidden ones are ignored. One holding both javabin
# files is a partition; one holding only one of them is a broken partition and fails the
# run rather than being skipped; any other is ignored.
#
# In <out-dir>, a subdirectory holding pheno.index is a partition of a store written by Rust
# HPDS v1 to v3, which this script does not replace: convert it with hpds-etl convert, or
# migrate into another directory. A subdirectory holding javabin files but no pheno.index
# fails the run, the rule hpds-etl and hpds-rs apply.
#
# Usage: bin/migrate-javabins [--dry-run] <javabin-dir> <out-dir>
#
#   --dry-run   print the resolved paths, the hpds-etl that would run and every mount, and
#               change nothing
#
# Every path is resolved to its real path (symbolic links followed) before anything is
# created. The script refuses an output or export directory inside the javabin directory,
# a javabin directory inside either of them, and an export directory inside the output
# directory or around it. A non-empty output directory is refused unless FORCE=1, and so is
# one holding .publish-journal (an interrupted hpds-etl remove-concepts), checked again just
# before the moves; run hpds-etl recover on it first.
#
# The new store is staged in <out-dir>/.next and its files are renamed into <out-dir> only
# once hpds-etl migrate has succeeded and, for a partitioned store, its etl-report.json names
# exactly the partitions exported. They move in this order: pheno.blocks, columnMeta.csv,
# etl-report.json, the key, pheno.index, and the .generation marker naming the new store
# last, so a reader that finds the new index finds the new blocks. An interrupt during the
# moves waits until they are done; afterwards everything is flushed with sync. A run that
# fails before the moves removes .next (and <out-dir> itself when this run created it), so
# <out-dir> is left as it was; one that fails during them says the store is partially
# published and is rerun with FORCE=1.
#
# An existing EXPORT_DIR must not hold another export: a partitioned run refuses one with a
# concepts.bin or patients.txt at its root, and any run refuses a subdirectory holding a
# concepts.bin that is not a partition being exported. Nothing in it is removed to make
# room.
#
# The export holds every observation, encrypted with the javabin store's key, in a
# directory of mode 0700. It is removed when the script exits, on success and on failure:
# the whole directory when the script created it, else the export files and their
# temporaries. KEEP_EXPORT=1 keeps it.
#
# Env:
#   JAVA_ETL_IMAGE   Java ETL image holding ExportForMigration
#                    (hms-dbmi/pic-sure-hpds-etl:bench). The :bench tag is not published:
#                    build it from the pic-sure root with
#                      mvn -pl services/pic-sure-hpds/etl -am install
#                    then, from services/pic-sure-hpds,
#                      docker build -f docker/pic-sure-hpds-etl/Dockerfile \
#                        -t hms-dbmi/pic-sure-hpds-etl:bench .
#   RUST_ETL_IMAGE   Rust ETL image (hms-dbmi/pic-sure-hpds-rs-etl:LATEST), built from
#                    services/pic-sure-hpds-rs with
#                      docker build -f docker/hpds-rs-etl.Dockerfile \
#                        -t hms-dbmi/pic-sure-hpds-rs-etl:LATEST .
#   HPDS_ETL         unset or "image" runs RUST_ETL_IMAGE (the default); "host" runs the first
#                    of $CARGO_TARGET_DIR/release/hpds-etl and $CARGO_TARGET_DIR/debug/hpds-etl
#                    (CARGO_TARGET_DIR defaults to target/) that runs; any other value is the
#                    path of an hpds-etl binary
#   EXPORT_DIR       where the intermediate export goes (a fresh temporary directory)
#   KEEP_EXPORT      1 keeps the export when the script exits
#   FORCE            1 migrates into a non-empty output directory, replacing the store files
#   CONTAINER_PREFIX prefix of the container names (etl-mig)
#   HEAPSIZE         Java heap in MiB for the exporter (4096). The exporter holds one cube
#                    at a time as its encrypted bytes, its plaintext and the deserialized
#                    objects, so the heap must exceed about 6 times the largest cube in
#                    allObservationsStore.javabin
set -euo pipefail

dry_run=0
if [[ "${1:-}" == "--dry-run" ]]; then
  dry_run=1
  shift
fi
if [[ $# -ne 2 ]]; then
  echo "usage: $0 [--dry-run] <javabin-dir> <out-dir>" >&2
  exit 2
fi

fail() {
  echo "migrate-javabins: $*" >&2
  exit 1
}

# Prints the real path of $1. A missing path resolves through its nearest existing
# ancestor, which must be a directory; its missing names may not be "." or "..".
resolve() {
  local path="$1" tail="" base
  [[ -n "$path" ]] || fail "an empty path was given"
  [[ "$path" == /* ]] || path="$PWD/$path"
  while [[ "$path" == */ && "$path" != "/" ]]; do path="${path%/}"; done
  while [[ ! -e "$path" ]]; do
    base="${path##*/}"
    if [[ "$base" == "." || "$base" == ".." || -z "$base" ]]; then
      fail "cannot resolve $1: '.' or '..' in a part that does not exist yet"
    fi
    tail="/$base$tail"
    path="${path%/*}"
    [[ -n "$path" ]] || path="/"
  done
  [[ -d "$path" ]] || fail "$path is not a directory"
  local real
  real="$(cd -P "$path" && pwd -P)"
  [[ "$real" == "/" && -n "$tail" ]] && real=""
  printf '%s%s\n' "$real" "$tail"
}

# True when $1 is $2 or inside it.
within() {
  [[ "$1" == "$2" || "$1" == "$2"/* ]]
}

root="$(cd -P "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
java_image="${JAVA_ETL_IMAGE:-hms-dbmi/pic-sure-hpds-etl:bench}"
rust_image="${RUST_ETL_IMAGE:-hms-dbmi/pic-sure-hpds-rs-etl:LATEST}"
heap="${HEAPSIZE:-4096}"
prefix="${CONTAINER_PREFIX:-etl-mig}"
[[ "$heap" =~ ^[0-9]+$ ]] || fail "HEAPSIZE must be a whole number of MiB"

[[ -d "$1" ]] || fail "$1 is not a directory"
source_dir="$(resolve "$1")"
out_dir="$(resolve "$2")"
if [[ -n "${EXPORT_DIR:-}" ]]; then
  export_dir="$(resolve "$EXPORT_DIR")"
else
  export_dir=""
fi

[[ -r "$source_dir/encryption_key" ]] || fail "$source_dir/encryption_key is missing or unreadable"
partitions=()
if [[ -e "$source_dir/columnMeta.javabin" || -e "$source_dir/allObservationsStore.javabin" ]]; then
  for name in columnMeta.javabin allObservationsStore.javabin; do
    [[ -r "$source_dir/$name" ]] || fail "$source_dir/$name is missing or unreadable"
  done
else
  for dir in "$source_dir"/*/; do
    [[ -d "$dir" ]] || continue
    dir="${dir%/}"
    if [[ -f "$dir/columnMeta.javabin" && -f "$dir/allObservationsStore.javabin" ]]; then
      for name in columnMeta.javabin allObservationsStore.javabin; do
        [[ -r "$dir/$name" ]] || fail "$dir/$name is unreadable"
      done
      partitions+=("${dir##*/}")
    elif [[ -e "$dir/columnMeta.javabin" || -e "$dir/allObservationsStore.javabin" ]]; then
      fail "$dir holds only one of columnMeta.javabin and allObservationsStore.javabin, a broken Java partition; repair it or move it out of $source_dir"
    fi
  done
  [[ ${#partitions[@]} -gt 0 ]] || fail "$source_dir holds neither a javabin store nor partition subdirectories holding one"
fi
within "$out_dir" "$source_dir" && fail "the output directory $out_dir is inside the javabin directory $source_dir"
within "$source_dir" "$out_dir" && fail "the javabin directory $source_dir is inside the output directory $out_dir"
if [[ -n "$export_dir" ]]; then
  within "$export_dir" "$source_dir" && fail "the export directory $export_dir is inside the javabin directory $source_dir"
  within "$source_dir" "$export_dir" && fail "the javabin directory $source_dir is inside the export directory $export_dir"
  within "$export_dir" "$out_dir" && fail "the export directory $export_dir is inside the output directory $out_dir"
  within "$out_dir" "$export_dir" && fail "the output directory $out_dir is inside the export directory $export_dir"
fi

if [[ -n "$export_dir" && -d "$export_dir" ]]; then
  if [[ ${#partitions[@]} -gt 0 ]]; then
    for name in concepts.bin patients.txt; do
      [[ -e "$export_dir/$name" ]] && fail "$export_dir holds $name of an unpartitioned export; empty it or choose another EXPORT_DIR"
    done
  fi
  for dir in "$export_dir"/*/; do
    [[ -e "$dir/concepts.bin" ]] || continue
    dir="${dir%/}"
    known=0
    for name in ${partitions[@]+"${partitions[@]}"}; do [[ "$name" == "${dir##*/}" ]] && known=1; done
    [[ "$known" == "1" ]] || fail "$export_dir holds ${dir##*/}/concepts.bin, an export of a partition this run does not export; empty it or choose another EXPORT_DIR"
  done
fi

refuse_pending_publish() {
  if [[ -e "$out_dir/.publish-journal" || -L "$out_dir/.publish-journal" ]]; then
    fail "$out_dir holds .publish-journal: an hpds-etl command was interrupted while replacing its store files. Run hpds-etl recover --store on it first"
  fi
}

if [[ -e "$out_dir" ]]; then
  [[ -d "$out_dir" ]] || fail "$out_dir exists and is not a directory"
  refuse_pending_publish
  if [[ -n "$(ls -A "$out_dir" | grep -vx '\.next' || true)" && "${FORCE:-0}" != "1" ]]; then
    fail "$out_dir is not empty; set FORCE=1 to replace the store files in it"
  fi
  if [[ -e "$out_dir/encryption_key" ]] && ! cmp -s "$source_dir/encryption_key" "$out_dir/encryption_key"; then
    fail "$out_dir/encryption_key exists and differs from the javabin store's key"
  fi
  for dir in "$out_dir"/*/; do
    [[ -d "$dir" ]] || continue
    dir="${dir%/}"
    [[ -f "$dir/pheno.index" ]] && continue
    if [[ -e "$dir/columnMeta.javabin" || -e "$dir/allObservationsStore.javabin" ]]; then
      fail "$dir holds javabin files but no pheno.index, a Java partition the Rust service would refuse to open; move it out of $out_dir"
    fi
  done
  for dir in "$out_dir"/*/; do
    [[ -f "$dir/pheno.index" ]] && fail "$out_dir holds partition stores written by Rust HPDS v1 to v3 (${dir%/}); convert them with hpds-etl convert, or migrate into another directory"
  done
fi
next_dir="$out_dir/.next"

host_binary=""
case "${HPDS_ETL:-image}" in
  image) ;;
  host)
    target="${CARGO_TARGET_DIR:-$root/target}"
    [[ "$target" == /* ]] || target="$root/$target"
    for candidate in "$target/release/hpds-etl" "$target/debug/hpds-etl"; do
      if [[ -x "$candidate" ]] && "$candidate" --version >/dev/null 2>&1; then
        host_binary="$candidate"
        break
      fi
    done
    [[ -n "$host_binary" ]] || fail "HPDS_ETL=host but no hpds-etl under $target/{release,debug} runs"
    ;;
  *)
    host_binary="$HPDS_ETL"
    [[ -x "$host_binary" ]] && "$host_binary" --version >/dev/null 2>&1 || fail "HPDS_ETL=$host_binary does not run"
    ;;
esac

suffix="$$-$(date +%s)"
user="$(id -u):$(id -g)"
export_mount_note="${export_dir:-<new temporary directory under ${TMPDIR:-/tmp}>}"

echo "javabin store: $source_dir (read-only)"
if [[ ${#partitions[@]} -gt 0 ]]; then
  echo "partitions:    ${partitions[*]}"
fi
echo "output:        $out_dir (staged in $next_dir)"
echo "export:        $export_mount_note"
echo "java exporter: $java_image, HEAPSIZE=${heap}m"
if [[ -n "$host_binary" ]]; then
  echo "hpds-etl:      host binary $host_binary ($("$host_binary" --version 2>/dev/null))"
else
  echo "hpds-etl:      image $rust_image"
fi

if [[ "$dry_run" == "1" ]]; then
  if [[ ${#partitions[@]} -gt 0 ]]; then
    echo "mounts, export step per partition <p> (container $prefix-export-*):"
    echo "  $source_dir/<p>/columnMeta.javabin, $source_dir/<p>/allObservationsStore.javabin,"
    echo "  $source_dir/encryption_key -> /opt/local/hpds/ (read-only)"
    echo "  $export_mount_note/<p> -> /opt/local/export"
  else
    echo "mounts, export step (container $prefix-export-*):"
    echo "  $source_dir -> /opt/local/hpds (read-only)"
    echo "  $export_mount_note -> /opt/local/export"
  fi
  if [[ -n "$host_binary" ]]; then
    echo "migrate step runs on the host: $host_binary migrate --export $export_mount_note --out $next_dir/store"
  else
    echo "mounts, migrate step (container $prefix-migrate-*):"
    echo "  $export_mount_note -> /export (read-only)"
    echo "  $next_dir -> /work"
  fi
  echo "key: install -m 600 $source_dir/encryption_key $next_dir/store/encryption_key"
  echo "then the store files move from $next_dir/store into $out_dir: pheno.blocks, columnMeta.csv, etl-report.json, the key, pheno.index, and .generation last"
  exit 0
fi

created_out=0
created_export=0
staged=0
cleanup() {
  local status=$?
  docker rm -f "$prefix-export-$suffix" "$prefix-migrate-$suffix" >/dev/null 2>&1 || true
  rm -rf "$next_dir"
  if [[ "$status" -ne 0 && "$created_out" == "1" ]]; then
    rmdir "$out_dir" 2>/dev/null || true
  fi
  if [[ -n "$export_dir" ]]; then
    if [[ "${KEEP_EXPORT:-0}" == "1" ]]; then
      echo "export kept in $export_dir" >&2
    elif [[ "$created_export" == "1" ]]; then
      rm -rf "$export_dir"
    else
      rm -f "$export_dir/concepts.bin" "$export_dir/patients.txt" \
        "$export_dir/concepts.bin.tmp" "$export_dir/patients.txt.tmp"
      for name in ${partitions[@]+"${partitions[@]}"}; do
        rm -rf "${export_dir:?}/$name"
      done
    fi
  fi
  if [[ "$status" -ne 0 && "$staged" == "0" ]]; then
    echo "migrate-javabins: failed; $out_dir is unchanged" >&2
  elif [[ "$status" -ne 0 && "$staged" == "1" ]]; then
    echo "migrate-javabins: failed while moving the store into $out_dir, which is now partially published; rerun with FORCE=1" >&2
  fi
  exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

if [[ ! -e "$out_dir" ]]; then
  mkdir -p -m 700 "$out_dir"
  created_out=1
fi
rm -rf "$next_dir"
mkdir -m 700 "$next_dir"

if [[ -n "$export_dir" ]]; then
  if [[ ! -e "$export_dir" ]]; then
    mkdir -p "$export_dir"
    created_export=1
  fi
else
  export_dir="$(mktemp -d "${TMPDIR:-/tmp}/hpds-export.XXXXXX")"
  export_dir="$(resolve "$export_dir")"
  created_export=1
fi
chmod 700 "$export_dir"

if [[ ${#partitions[@]} -gt 0 ]]; then
  for name in "${partitions[@]}"; do
    echo "exporting partition $name to $export_dir/$name"
    rm -rf "${export_dir:?}/$name"
    mkdir -m 700 "$export_dir/$name"
    docker run --rm --name "$prefix-export-$suffix" --user "$user" \
      -e LOADER_NAME=ExportForMigration \
      -e LOADER_ARGS="/opt/local/hpds /opt/local/export" \
      -e HEAPSIZE="$heap" \
      -v "$source_dir/$name/columnMeta.javabin:/opt/local/hpds/columnMeta.javabin:ro" \
      -v "$source_dir/$name/allObservationsStore.javabin:/opt/local/hpds/allObservationsStore.javabin:ro" \
      -v "$source_dir/encryption_key:/opt/local/hpds/encryption_key:ro" \
      -v "$export_dir/$name:/opt/local/export" \
      "$java_image"
  done
else
  echo "exporting $source_dir to $export_dir"
  docker run --rm --name "$prefix-export-$suffix" --user "$user" \
    -e LOADER_NAME=ExportForMigration \
    -e LOADER_ARGS="/opt/local/hpds /opt/local/export" \
    -e HEAPSIZE="$heap" \
    -v "$source_dir:/opt/local/hpds:ro" \
    -v "$export_dir:/opt/local/export" \
    "$java_image"
fi

mkdir -m 700 "$next_dir/store"
install -m 600 "$source_dir/encryption_key" "$next_dir/store/encryption_key"

echo "migrating into $next_dir/store"
if [[ -n "$host_binary" ]]; then
  "$host_binary" migrate --export "$export_dir" --out "$next_dir/store"
else
  docker run --rm --name "$prefix-migrate-$suffix" --user "$user" \
    -v "$export_dir:/export:ro" \
    -v "$next_dir:/work" \
    "$rust_image" migrate --export /export --out /work/store
fi

store_files=(pheno.blocks columnMeta.csv etl-report.json encryption_key pheno.index .generation)
for name in "${store_files[@]}"; do
  [[ -f "$next_dir/store/$name" ]] || fail "hpds-etl migrate did not write $name"
done
if [[ ${#partitions[@]} -gt 0 ]]; then
  command -v jq >/dev/null || fail "jq is needed to check the partitions hpds-etl migrate wrote"
  expected="$(printf '%s\n' "${partitions[@]}" | LC_ALL=C sort)"
  reported="$(jq -r '.partitions | keys[]' "$next_dir/store/etl-report.json" | LC_ALL=C sort)" \
    || fail "cannot read the partitions of $next_dir/store/etl-report.json"
  [[ "$reported" == "$expected" ]] \
    || fail "hpds-etl migrate wrote partitions $(echo $reported) where $(echo $expected) were exported"
fi
refuse_pending_publish
trap '' INT TERM
staged=1
for name in "${store_files[@]}"; do
  mv -f "$next_dir/store/$name" "$out_dir/$name"
done
staged=2
trap 'exit 130' INT
trap 'exit 143' TERM
sync
if [[ ${#partitions[@]} -gt 0 ]]; then
  echo "migrated ${#partitions[@]} partitions into one store in $out_dir"
else
  echo "migrated store in $out_dir"
fi
